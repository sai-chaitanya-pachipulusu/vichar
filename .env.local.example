# ─────────────────────────────────────────────
#  Vichar — Environment Variables
#  Copy this file to .env.local and fill in the values.
#  See README.md for step-by-step instructions.
# ─────────────────────────────────────────────

# ── Anthropic ──────────────────────────────────────────────────────────────────
# Get this from: https://console.anthropic.com → API Keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=

# ── Upstash Redis ──────────────────────────────────────────────────────────────
# Stores workspace source metadata (file names, chunk counts, source IDs).
# Get these from: https://console.upstash.com → your Redis database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Upstash Vector ─────────────────────────────────────────────────────────────
# Stores text chunk embeddings for semantic search across uploaded documents.
# Get these from: https://console.upstash.com → your Vector index → REST API
# Index settings: Dimensions=1536, Distance Metric=Cosine
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
